.app-root {
    width: 100%; height: 100%;
    background-color: rgb(239, 241, 245);
    color: rgb(26, 43, 62);
}
.screen {
    width: 100%; height: 100%;
    flex-direction: column; align-items: center;
    padding-left: 5%; padding-right: 5%; padding-top: 3%; padding-bottom: 3%;
}
.hidden { display: none; }
.home-screen { justify-content: center; }
.brand-title {
    color: rgb(38, 78, 127); font-size: 48px;
    -unity-font-style: bold; -unity-text-align: middle-center;
}
.brand-subtitle {
    color: rgb(88, 105, 124); font-size: 16px;
    -unity-text-align: middle-center; margin-bottom: 20px;
}
.home-actions { width: 82%; max-width: 350px; flex-direction: column; }
.menu-button, .back-button, .tab-button {
    color: rgb(255, 255, 255); font-size: 20px; -unity-font-style: bold;
    border-top-width: 0; border-bottom-width: 0; border-left-width: 0; border-right-width: 0;
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
    -unity-text-align: middle-center;
}
.menu-button { width: 100%; height: 48px; margin-top: 4px; margin-bottom: 4px; }
.primary { background-color: rgb(38, 78, 127); }
.secondary { background-color: rgb(71, 111, 154); }
.tertiary { background-color: rgb(109, 121, 137); }
.menu-button:hover, .back-button:hover, .tab-button:hover { background-color: rgb(31, 66, 108); }
.detail-screen { align-items: stretch; }
.page-title {
    color: rgb(38, 78, 127); font-size: 32px; -unity-font-style: bold;
    -unity-text-align: middle-center; margin-top: 6px;
}
.page-subtitle { color: rgb(88, 105, 124); font-size: 15px; -unity-text-align: middle-center; margin-bottom: 8px; }
.content-scroll {
    flex-grow: 1; min-height: 40px; background-color: rgb(255, 255, 255);
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
    padding-left: 12px; padding-right: 12px; padding-top: 8px; padding-bottom: 8px;
}
.rule-heading { font-size: 19px; -unity-font-style: bold; color: rgb(38, 78, 127); margin-top: 10px; margin-bottom: 2px; white-space: normal; }
.rule-body { font-size: 16px; color: rgb(35, 46, 61); margin-bottom: 6px; white-space: normal; }
.ranking-tabs { flex-direction: row; justify-content: center; margin-bottom: 6px; }
.tab-button { flex-grow: 1; height: 42px; font-size: 17px; background-color: rgb(105, 128, 151); margin-left: 3px; margin-right: 3px; }
.tab-active { background-color: rgb(38, 78, 127); }
.rank-row { flex-direction: row; justify-content: space-between; padding-left: 8px; padding-right: 8px; padding-top: 6px; padding-bottom: 6px; border-bottom-width: 1px; border-bottom-color: rgb(225, 231, 238); }
.rank-position { font-size: 18px; color: rgb(88, 105, 124); -unity-font-style: bold; }
.rank-time { font-size: 20px; color: rgb(38, 78, 127); -unity-font-style: bold; }
.empty-message { font-size: 16px; color: rgb(88, 105, 124); white-space: normal; margin-top: 12px; }
.back-button { height: 46px; background-color: rgb(38, 78, 127); margin-top: 8px; flex-shrink: 0; }

.menu-logo {
    display: none; width: 160px; height: 70px; margin-bottom: 6px;
}

.ranking-title {
    font-size: 24px;
    white-space: normal;
}
.ranking-subtitle {
    font-size: 13px;
    white-space: normal;
}
